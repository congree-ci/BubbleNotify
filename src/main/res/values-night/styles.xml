<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
<style name="AppPickerTheme" parent="android:style/Theme.Material.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
</resources>
